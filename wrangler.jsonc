{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vozkovo-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "JOBS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "r2_buckets": [
    { "binding": "AUDIO", "bucket_name": "vozkovo-audio" }
  ]
}
